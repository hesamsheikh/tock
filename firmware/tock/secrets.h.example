// Optional. Copy to secrets.h (which git ignores) for settings that belong to your FIRE only.
// Wi-Fi is not set here: send it from the Mac app, or once over USB with firmware/wifi-setup.sh.
#pragma once

// Your POSIX time zone, for the clock and for when a day starts in Stats (default: UTC).
// Find yours in https://github.com/nayarsystems/posix_tz_db/blob/master/zones.csv, for example
//   "CET-1CEST,M3.5.0,M10.5.0/3"   Central Europe
//   "EST5EDT,M3.2.0,M11.1.0"       US Eastern
//   "PST8PDT,M3.2.0,M11.1.0"       US Pacific
#define TOCK_TZ "UTC0"
